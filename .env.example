# Neon PostgreSQL - pooled connection string for the current environment.
# Local development: copy this file to `.env.local` and fill in the pooled
# connection string from Neon Console (Connect -> branch "dev" -> Pooled).
# Staging: set its own separate value in the staging environment's secret store.
# Never commit `.env.local` or any real connection string.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Neon PostgreSQL - direct (unpooled) connection string.
# Used only by the Prisma CLI (migrations and introspection) in prisma7.config.ts.
# Copy the "Direct connection" value from Neon Console for the same branch.
# Do not use this URL for application runtime traffic.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Optional: dedicated shadow database for `prisma migrate dev`, using a direct
# connection. Not required for `prisma migrate deploy` or `prisma migrate diff`.
# SHADOW_DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
